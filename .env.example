# Copy this file to .env and fill it in. Leave everything empty to run in demo mode.

# Firebase console → Project settings → Your apps → Web app → SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Project settings → Cloud Messaging → Web Push certificates → Generate key pair (for push notifications)
VITE_FIREBASE_VAPID_KEY=

# Paystack dashboard → Settings → API Keys & Webhooks (PUBLIC key only; never put the secret key here)
VITE_PAYSTACK_PUBLIC_KEY=

# Printed by `firebase deploy --only functions`, e.g. https://europe-west1-<project>.cloudfunctions.net/verifyPayment
VITE_VERIFY_PAYMENT_URL=
