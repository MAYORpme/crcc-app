rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Members' own profile photos (max 5 MB, images only)
    match /members/{uid}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // Everything else (sermon audio, PDFs, photos) is uploaded by church admins. 300 MB max per file.
    match /{path=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin() && request.resource.size < 300 * 1024 * 1024;
    }
  }
}
